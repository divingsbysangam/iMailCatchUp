# Copy to .env for local development. On Railway, set these under Service → Variables.
# Secrets marked (setup) come from `npm run setup`. NEVER commit real values.

NODE_ENV=development
PORT=3000
# Exact URL you open the app at. Local dev (Vite): http://localhost:5173
# Railway: https://<your-service>.up.railway.app (or your custom domain)
PUBLIC_ORIGIN=http://localhost:5173
# Railway: mount a volume at /data and set DATABASE_PATH=/data/app.db
DATABASE_PATH=./data/app.db

# iCloud: appleid.apple.com → Sign-In and Security → App-Specific Passwords (needs 2FA)
ICLOUD_EMAIL=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAILBOXES=INBOX
SYNC_DAYS=14
# true = only unread mail appears in the app; mail you read elsewhere disappears on the next sync
SYNC_UNREAD_ONLY=true
SYNC_INTERVAL_MINUTES=10

# OpenAI: platform.openai.com → API keys. Set a monthly budget limit there.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# Evening brief (24h clock, IANA time zone)
BRIEF_TIME=19:00
BRIEF_TIMEZONE=Asia/Kolkata
BRIEF_MAX_EMAILS=80
# Max characters per email sent to the AI, after removing quoted replies, signatures and links.
# Newsletters/notifications send only sender + subject. Lower = cheaper, higher = more context.
BRIEF_BODY_CHARS=800
# Same for newsletters/notifications, after removing "view in browser", unsubscribe footers etc.
# 0 = send only sender + subject.
BRIEF_BULK_CHARS=800
# false = lock-screen notification says only "Your brief is ready."
BRIEF_PUSH_PREVIEW=true

# (setup) Login + encryption
APP_PASSWORD_HASH=
TOTP_SECRET=
DATA_ENCRYPTION_KEY=
SESSION_TTL_HOURS=336

# Client IP for rate limiting comes from this header, set by the hosting proxy (Railway: x-real-ip).
# X-Forwarded-For is never used: clients can forge it.
CLIENT_IP_HEADER=x-real-ip
# (setup) Behind Cloudflare: a Transform Rule adds this value as the X-Origin-Auth header.
# When it matches, CF-Connecting-IP is used as the client IP.
CLOUDFLARE_ORIGIN_SECRET=
# true = refuse every request that didn't come through Cloudflare (except /healthz)
REQUIRE_CLOUDFLARE=false

# (setup) Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
