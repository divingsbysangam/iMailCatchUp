# Copy to .env for local development. On Railway, set these under Service → Variables.
# Secrets marked (setup) come from `npm run setup`. NEVER commit real values.

NODE_ENV=development
PORT=3000
# Exact URL you open the app at. Local dev (Vite): http://localhost:5173
# Railway: https://<your-service>.up.railway.app (or your custom domain)
PUBLIC_ORIGIN=http://localhost:5173
# Railway: mount a volume at /data and set DATABASE_PATH=/data/app.db
DATABASE_PATH=./data/app.db

# iCloud: appleid.apple.com → Sign-In and Security → App-Specific Passwords (needs 2FA)
ICLOUD_EMAIL=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAILBOXES=INBOX
SYNC_DAYS=14
SYNC_INTERVAL_MINUTES=10

# OpenAI: platform.openai.com → API keys. Set a monthly budget limit there.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# Evening brief (24h clock, IANA time zone)
BRIEF_TIME=19:00
BRIEF_TIMEZONE=Asia/Kolkata
BRIEF_MAX_EMAILS=80
# false = lock-screen notification says only "Your brief is ready."
BRIEF_PUSH_PREVIEW=true

# (setup) Login + encryption
APP_PASSWORD_HASH=
TOTP_SECRET=
DATA_ENCRYPTION_KEY=
SESSION_TTL_HOURS=336

# (setup) Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
