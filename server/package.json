    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "imapflow": "^2.1.2",
    "mailparser": "^3.9.31",
    "openai": "^7.25.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.3",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
